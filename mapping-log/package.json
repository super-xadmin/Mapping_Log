{
  "name": "mapping-log",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply mapping-log --local",
    "db:migrate:remote": "wrangler d1 migrations apply mapping-log --remote",
    "deploy": "npm run build && wrangler d1 migrations apply mapping-log --remote && wrangler deploy"
  },
  "dependencies": {
    "hono": "4.13.13",
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.0",
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "wrangler": "4.148.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
